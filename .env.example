# Copy to ~/.config/opencode/exa-search.env and fill in.
# This file holds secrets - keep it out of git (chmod 600).

# Required: Exa API key (https://dashboard.exa.ai)
EXA_API_KEY=your-exa-api-key

# Optional: SOCKS5 proxy, host:port. Needed where Exa is Cloudflare-blocked.
EXA_PROXY=1.2.3.4:1080

# Optional: proxy auth as "user:pass"
EXA_PROXY_USER=
